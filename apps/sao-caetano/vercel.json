{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/pmax", "destination": "/index.html" },
    { "source": "/pmax/(.*)", "destination": "/index.html" },
    { "source": "/whats", "destination": "/index.html" },
    { "source": "/formulario", "destination": "/index.html" },
    { "source": "/formulario/etapas", "destination": "/index.html" },
    { "source": "/obrigado", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*\\.(?:avif|webp|jpg|jpeg|png|svg|woff2|mp4))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
